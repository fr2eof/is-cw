@startuml
title Архитектура приложения Ocean Expeditions Backend

skinparam packageStyle rectangle
skinparam linetype ortho

package "Уровень REST API" {
    class ExpeditionController {
        +getAllExpeditions()
        +getExpeditionById()
        +getExpeditionByCode()
        +createExpedition()
        +updateExpedition()
        +deleteExpedition()
        +startExpedition()
        +completeExpedition()
    }
    
    class VesselController {
        +getAllVessels()
        +getVesselById()
        +getVesselsByStatus()
        +createVessel()
        +updateVessel()
        +deleteVessel()
    }
    
    class CrewController {
        +getAllCrewMembers()
        +getCrewMemberById()
        +createCrewMember()
        +updateCrewMember()
        +assignCrewToExpedition()
        +removeCrewFromExpedition()
        +getCrewForExpedition()
    }
    
    class MissionTaskController {
        +getTasksByExpedition()
        +getTaskById()
        +createTask()
        +updateTask()
        +deleteTask()
    }
    
    class IncidentController {
        +getIncidentsByExpedition()
        +getUnresolvedIncidents()
        +getIncidentById()
        +createIncident()
        +resolveIncident()
    }
    
    class SensorObservationController {
        +getObservationsBySensor()
        +getObservationsByExpedition()
        +createObservation()
    }
    
    class InventoryController {
        +getInventoryByExpedition()
        +createInventoryItem()
        +adjustInventory()
    }
    
    class GlobalExceptionHandler {
        +handleResourceNotFoundException()
        +handleIllegalStateException()
        +handleIllegalArgumentException()
        +handleGenericException()
    }
}

package "Уровень бизнес-логики" {
    class ExpeditionService {
        +getAllExpeditions()
        +getExpeditionById()
        +getExpeditionByCode()
        +createExpedition()
        +updateExpedition()
        +deleteExpedition()
        +startExpedition()
        +completeExpedition()
        -toDto()
        -toEntity()
    }
    
    class VesselService {
        +getAllVessels()
        +getVesselById()
        +getVesselsByStatus()
        +createVessel()
        +updateVessel()
        +deleteVessel()
        -toDto()
        -toEntity()
    }
    
    class CrewService {
        +getAllCrewMembers()
        +getCrewMemberById()
        +createCrewMember()
        +updateCrewMember()
        +assignCrewToExpedition()
        +removeCrewFromExpedition()
        +getCrewForExpedition()
        -toDto()
        -toEntity()
    }
    
    class MissionTaskService {
        +getTasksByExpedition()
        +getTaskById()
        +createTask()
        +updateTask()
        +deleteTask()
        -toDto()
        -toEntity()
    }
    
    class SensorObservationService {
        +getObservationsBySensor()
        +getObservationsByExpedition()
        +createObservation()
        -toDto()
    }
    
    class IncidentService {
        +getIncidentsByExpedition()
        +getUnresolvedIncidents()
        +getIncidentById()
        +createIncident()
        +resolveIncident()
        -toDto()
    }
    
    class InventoryService {
        +getInventoryByExpedition()
        +createInventoryItem()
        +adjustInventory()
        -toDto()
    }
}

package "Уровень доступа к данным" {
    class ExpeditionRepository {
        +findByCode()
        +findByStatus()
        +findByVesselId()
        +findByDateRange()
    }
    
    class VesselRepository {
        +findByImoNumber()
        +findByStatus()
    }
    
    class CrewMemberRepository {
        +findByEmail()
        +findByStatus()
        +findAvailableForExpedition()
    }
    
    class CrewAssignmentRepository {
        +findByExpeditionId()
        +findByCrewId()
        +existsByExpeditionIdAndCrewId()
    }
    
    class MissionTaskRepository {
        +findByExpeditionId()
        +findByStatus()
        +findByExpeditionIdAndStatus()
        +findByResponsibleCrewId()
        +findRootTasksByExpeditionId()
    }
    
    class SensorObservationRepository {
        +findBySensorId()
        +findByExpeditionId()
        +findByQcStatus()
        +findLatestBySensorId()
        +findBySensorIdAndTimeRange()
    }
    
    class IncidentRepository {
        +findByExpeditionId()
        +findBySeverity()
        +findUnresolvedByExpeditionId()
    }
    
    class InventoryItemRepository {
        +findByExpeditionId()
        +findItemsWithStock()
        +findLowStockItems()
    }
    
    class InventoryTransactionRepository {
        +findByItemId()
        +findHistoryByItemId()
        +findByExpeditionIdAndTimeRange()
    }
    
    class PortRepository {
        +findByUnlocode()
    }
    
    class PortCallRepository {
        +findByExpeditionId()
        +findByPortId()
    }
    
    class RoleRepository {
        +findByCode()
    }
    
    class CertificationRepository {
    }
    
    class CrewCertificationRepository {
        +findByCrewId()
        +findByCertificationId()
        +findExpiredCertifications()
    }
    
    class EquipmentRepository {
        +findBySerialNumber()
        +findByCondition()
        +findByCategory()
    }
    
    class ExpeditionEquipmentRepository {
        +findByExpeditionId()
        +findByEquipmentId()
    }
    
    class EnvironmentalRuleRepository {
        +findByName()
        +findByActiveTrue()
        +findByParameterAndActiveTrue()
    }
    
    class SensorRepository {
        +findBySensorType()
        +findByInstalledOnVesselId()
        +findByRuleId()
    }
    
    class PermitRepository {
        +findByExpeditionId()
        +findValidPermitsForExpedition()
    }
    
    class DocumentRepository {
        +findByExpeditionId()
        +findByDocType()
    }
    
    class SystemAuditRepository {
        +findByObjectType()
        +findByObjectTypeAndObjectId()
        +findByTimeRange()
    }
}

package "Уровень JPA/Entity" {
    class Expedition {
        -Integer id
        -String code
        -String name
        -String description
        -Vessel vessel
        -Long managerUserId
        -LocalDate plannedStart
        -LocalDate plannedEnd
        -Instant actualStart
        -Instant actualEnd
        -ExpeditionStatus status
    }
    
    class Vessel {
        -Integer id
        -String imoNumber
        -String name
        -String callSign
        -BigDecimal capacityTons
        -Integer builtYear
        -VesselStatus status
    }
    
    class CrewMember {
        -Integer id
        -String externalId
        -String firstName
        -String lastName
        -LocalDate birthDate
        -String nationality
        -String email
        -String phone
        -CrewStatus status
    }
    
    class Role {
        -Integer id
        -String code
        -String title
        -Boolean minCertRequired
    }
    
    class CrewAssignment {
        -Expedition expedition
        -CrewMember crew
    }
    
    class MissionTask {
        -Integer id
        -Expedition expedition
        -MissionTask parentTask
        -String title
        -String description
        -CrewMember responsibleCrew
        -Instant plannedStart
        -Instant plannedEnd
        -TaskStatus status
    }
    
    class SensorObservation {
        -Integer id
        -Sensor sensor
        -Expedition expedition
        -Instant observedAt
        -BigDecimal valueNum
        -String valueText
        -QcStatus qcStatus
    }
    
    class Incident {
        -Integer id
        -Expedition expedition
        -Instant reportedAt
        -CrewMember reportedByCrew
        -IncidentSeverity severity
        -String category
        -String description
        -Instant resolvedAt
    }
    
    class InventoryItem {
        -Integer id
        -Expedition expedition
        -String name
        -String unit
        -BigDecimal quantityOnboard
    }
    
    class InventoryTransaction {
        -Integer id
        -InventoryItem item
        -TransactionType txnType
        -BigDecimal qty
        -Instant txnTs
        -CrewMember performedBy
        -String notes
    }
    
    class Port {
        -Integer id
        -String name
        -String country
        -BigDecimal latitude
        -BigDecimal longitude
        -String unlocode
    }
    
    class PortCall {
        -Integer id
        -Expedition expedition
        -Port port
        -Instant arrivalTs
        -Instant departureTs
        -String operationNotes
    }
    
    class Certification {
        -Integer id
        -String name
        -String issuer
        -LocalDate validFrom
        -LocalDate validTo
    }
    
    class CrewCertification {
        -CrewMember crew
        -Certification certification
        -String certificateNumber
        -LocalDate issuedDate
        -LocalDate expiryDate
    }
    
    class Equipment {
        -Integer id
        -String serialNumber
        -String name
        -String category
        -EquipmentCondition condition
        -String locationDescription
    }
    
    class ExpeditionEquipment {
        -Expedition expedition
        -Equipment equipment
    }
    
    class EnvironmentalRule {
        -Integer id
        -String name
        -String parameter
        -BigDecimal thresholdValue
        -ThresholdOperator thresholdOperator
        -Boolean active
    }
    
    class Sensor {
        -Integer id
        -Equipment equipment
        -String name
        -String sensorType
        -String unit
        -Vessel installedOnVessel
        -Instant installedAt
        -EnvironmentalRule rule
    }
    
    class Permit {
        -Integer id
        -Expedition expedition
        -String permitType
        -String issuingAuthority
        -LocalDate validFrom
        -LocalDate validTo
        -String documentRef
    }
    
    class Document {
        -Integer id
        -Expedition expedition
        -String docType
        -String title
        -String version
        -String storedAt
        -CrewMember uploadedBy
        -Instant uploadedAt
    }
    
    class SystemAudit {
        -Integer id
        -Instant eventTs
        -String objectType
        -String objectId
        -String action
        -CrewMember performedBy
        -Map<String, Object> details
    }
    
    enum ExpeditionStatus {
        planned
        ready
        active
        completed
        cancelled
    }
    
    enum VesselStatus {
        available
        on_mission
        maintenance
        decommissioned
    }
    
    enum CrewStatus {
        active
        inactive
        onboard
        on_leave
    }
    
    enum TaskStatus {
        pending
        in_progress
        done
        blocked
        cancelled
    }
    
    enum QcStatus {
        unchecked
        ok
        flagged
        invalid
    }
    
    enum IncidentSeverity {
        low
        medium
        high
        critical
    }
    
    enum TransactionType {
        load
        unload
        consume
        transfer_in
        transfer_out
        adjust
    }
    
    enum EquipmentCondition {
        good
        needs_service
        retired
    }
    
    enum ThresholdOperator {
        LE
        GE
        GT
        LT
    }
}

